# Copy to a private file (e.g. `yse/config/local.env`) and `source` it before running scripts.
# Do not commit real values.

# --- UCOLICK archive (APF / Kast / Nickel) ---
export UCOLICK_HTTP_USER=""
export UCOLICK_HTTP_PASSWORD=""
# URL path segment for your data folder on the server, e.g. "Charles.Kilpatrick"
export UCOLICK_APF_ARCHIVE_USER=""
export UCOLICK_KAST_ARCHIVE_USER=""
# JSON file: list of {"archive_folder":"...","http_user":"...","http_password":"..."}
# See yse/config/nickel_accounts.example.json
export UCOLICK_NICKEL_ACCOUNTS_JSON=""
# Optional download roots (defaults under cwd)
# export UCOLICK_RAWDIR_APF=""
# export UCOLICK_RAWDIR_KAST=""
